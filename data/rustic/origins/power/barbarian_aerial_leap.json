{
  "type": "origins:multiple",
  "leap": {
    "type": "origins:active_self",
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:add_velocity",
          "x": 0.0,
          "y": 1.1,
          "z": 0.0,
          "space": "velocity",
          "set": false
        },
        {
          "type": "origins:play_sound",
          "sound": "minecraft:entity.wind_charge.wind_burst",
          "volume": 1.2,
          "pitch": 0.8
        },
        {
          "type": "origins:spawn_particles",
          "particle": {
            "type": "minecraft:cloud"
          },
          "count": 12,
          "speed": 0.2,
          "force": true,
          "spread": [
            0.4,
            0.1,
            0.4
          ]
        }
      ]
    },
    "cooldown": 300,
    "hud_render": {
      "should_render": true,
      "bar_index": 1
    },
    "key": {
      "key": "key.origins.secondary_active"
    },
    "badges": [
      {
        "type": "origins:keybind",
        "sprite": "origins:textures/gui/badge/active.png",
        "text": "Apasă %s pentru Saltul Haiducesc: sari puternic în aer. La aterizare, creezi o undă de șoc ce aruncă și rănește vrăjmașii."
      }
    ]
  },
  "no_fall_damage": {
    "type": "origins:modify_damage_taken",
    "modifier": {
      "operation": "multiply_total_additive",
      "value": -1.0
    },
    "damage_condition": {
      "type": "origins:id",
      "value": "minecraft:fall"
    }
  },
  "landing_shockwave": {
    "type": "origins:action_on_land",
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:play_sound",
          "sound": "minecraft:entity.generic.explode",
          "volume": 0.8,
          "pitch": 1.4
        },
        {
          "type": "origins:spawn_particles",
          "particle": {
            "type": "minecraft:explosion"
          },
          "count": 4,
          "speed": 0.1,
          "force": true,
          "spread": [
            0.5,
            0.1,
            0.5
          ]
        },
        {
          "type": "origins:region_apply",
          "radius": 5.0,
          "shape": "sphere",
          "bientity_action": {
            "type": "origins:and",
            "actions": [
              {
                "type": "origins:damage_target",
                "damage_type": "minecraft:player_attack",
                "amount": 6.0
              },
              {
                "type": "origins:add_velocity",
                "x": 0.0,
                "y": 0.8,
                "z": 0.0
              }
            ]
          },
          "bientity_condition": {
            "type": "origins:target_condition",
            "condition": {
              "type": "origins:entity_type",
              "entity_type": "minecraft:player",
              "inverted": true
            }
          },
          "includeActor": false
        },
        {
          "type": "origins:execute_command",
          "command": "execute at @s as @e[type=!player,distance=..5.0] run damage @s 6.0 minecraft:player_attack by @p"
        }
      ]
    }
  },
  "name": "Saltul Barbarului",
  "description": {
    "text": "[Apasă ",
    "extra": [
      {
        "keybind": "key.origins.secondary_active",
        "bold": true,
        "color": "gold"
      },
      {
        "text": " (Abilitate Secundară)] Sari puternic în aer. La aterizare declanșezi o undă de șoc ce aruncă inamicii și le provoacă 6 daune."
      }
    ]
  }
}