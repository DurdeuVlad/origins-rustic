{
  "type": "origins:multiple",
  "toggle": {
    "type": "origins:toggle",
    "active_by_default": false,
    "key": {
      "key": "key.origins.primary_active"
    },
    "badges": [
      {
        "type": "origins:keybind",
        "sprite": "origins:textures/gui/badge/toggle.png",
        "text": "Apas\u0103 %s pentru a activa/dezactiva zborul estic."
      }
    ]
  },
  "flight": {
    "type": "origins:elytra_flight",
    "render_elytra": true,
    "condition": {
      "type": "origins:power_active",
      "power": "*:*_toggle"
    }
  },
  "hunger_drain": {
    "type": "origins:action_over_time",
    "interval": 10,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "*:*_toggle"
        },
        {
          "type": "origins:fall_flying"
        }
      ]
    },
    "entity_action": {
      "type": "origins:exhaust",
      "amount": 1.0
    }
  },
  "name": "Draconic Wings",
  "description": "You can sprout wings and take flight, provided you are not weighed down by heavy armor."
}