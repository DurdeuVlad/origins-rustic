{
  "type": "origins:multiple",
  "toggle": {
    "type": "origins:toggle",
    "active_by_default": false,
    "key": {
      "key": "key.origins.primary_active"
    }
  },
  "flight": {
    "type": "origins:elytra_flight",
    "render_elytra": true,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "*:*_toggle"
        },
        {
          "type": "origins:equipped_item",
          "equipment_slot": "head",
          "item_condition": {
            "type": "origins:ingredient",
            "ingredient": {
              "item": "minecraft:air"
            }
          }
        },
        {
          "type": "origins:equipped_item",
          "equipment_slot": "chest",
          "item_condition": {
            "type": "origins:ingredient",
            "ingredient": {
              "item": "minecraft:air"
            }
          }
        },
        {
          "type": "origins:equipped_item",
          "equipment_slot": "legs",
          "item_condition": {
            "type": "origins:ingredient",
            "ingredient": {
              "item": "minecraft:air"
            }
          }
        },
        {
          "type": "origins:equipped_item",
          "equipment_slot": "feet",
          "item_condition": {
            "type": "origins:ingredient",
            "ingredient": {
              "item": "minecraft:air"
            }
          }
        }
      ]
    }
  },
  "hunger_drain": {
    "type": "origins:action_over_time",
    "interval": 10,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "*:*_toggle"
        },
        {
          "type": "origins:fall_flying"
        }
      ]
    },
    "entity_action": {
      "type": "origins:exhaust",
      "amount": 1.0
    }
  },
  "prevent_firework": {
    "type": "origins:prevent_item_use",
    "condition": {
      "type": "origins:fall_flying"
    },
    "item_condition": {
      "type": "origins:ingredient",
      "ingredient": {
        "item": "minecraft:firework_rocket"
      }
    }
  }
}